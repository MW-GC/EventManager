@page "/themes"
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inject ThemeService ThemeSvc
@inject FocusReturn Focus

<PageHeader Title="Themes" Subtitle="Manage activity themes for event filtering" />
<ApiErrorBar Message="@_loads.Message" OnRetry="Reload" />
<ApiErrorBar Message="@_actionError" OnDismiss="@(() => _actionError = null)" />

<FluentStack Orientation="Orientation.Vertical" VerticalGap="24">
    @if (_themes is null)
    {
        @if (!_loads.Failed("Themes"))
        {
            <FluentCard AreaRestricted="false">
                <div style="align-items: center; display: flex; gap: 12px; justify-content: center; min-height: 200px;">
                    <FluentProgressRing />
                    <FluentLabel>Loading themes...</FluentLabel>
                </div>
            </FluentCard>
        }
    }
    else
    {
        <FluentCard Style="overflow: visible;" AreaRestricted="false">
            <FluentStack Orientation="Orientation.Horizontal"
                         HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                         VerticalAlignment="VerticalAlignment.Center"
                         Style="margin-bottom: 16px;"
                         Wrap="true">
                <FluentSearch @bind-Value="_search" @bind-Value:after="HandleSearch" Placeholder="Search themes..." aria-label="Search themes" />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                    <FluentButton Appearance="@(_viewMode == ViewMode.Table ? Appearance.Accent : Appearance.Outline)"
                                  Size="ButtonSize.Small" OnClick="@(() => _viewMode = ViewMode.Table)"
                                  IconStart="@(new Size16.TextBulletListSquare())" Title="Table view"
                                  aria-pressed="@(_viewMode == ViewMode.Table ? "true" : "false")" />
                    <FluentButton Appearance="@(_viewMode == ViewMode.Cards ? Appearance.Accent : Appearance.Outline)"
                                  Size="ButtonSize.Small" OnClick="@(() => _viewMode = ViewMode.Cards)"
                                  IconStart="@(new Size16.Grid())" Title="Card view"
                                  aria-pressed="@(_viewMode == ViewMode.Cards ? "true" : "false")" />
                    <FluentButton Appearance="Appearance.Accent" OnClick="ShowCreate" IconStart="@(new Size16.Add())" data-focus-key="add">Add Theme</FluentButton>
                </FluentStack>
            </FluentStack>

            @if (_viewMode == ViewMode.Table)
            {
                <FluentDataGrid Items="@Filtered" TGridItem="ThemeEntity" Virtualize="true" ItemSize="44">
                    <PropertyColumn Property="@(t => t.Name)" Title="Name" Sortable="true" />
                    <TemplateColumn Title="Actions">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                            <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Title="Edit" aria-label="@($"Edit {context.Name}")" data-focus-key="@($"edit-{context.Id}")"
                                          Disabled="@_rows.IsBusy(context.Id)" OnClick="@(() => ShowEdit(context))">
                                <FluentIcon Value="@(new Size16.Edit())" />
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Title="Delete" aria-label="@($"Delete {context.Name}")" data-focus-key="@($"delete-{context.Id}")"
                                          Disabled="@_rows.Running" OnClick="@(() => AskDelete(context))">
                                <FluentIcon Value="@(new Size16.Delete())" />
                            </FluentButton>
                        </FluentStack>
                    </TemplateColumn>
                </FluentDataGrid>
            }
            else
            {
                <FluentGrid Spacing="3" Justify="JustifyContent.FlexStart">
                    @foreach (var theme in Filtered)
                    {
                        <FluentGridItem xs="6" sm="4" md="3" lg="2">
                            <FluentCard Style="text-align: center; padding: 16px;" AreaRestricted="false">
                                <FluentIcon Value="@(new Size24.Color())" Color="Color.Accent" Style="margin-bottom: 8px;" />
                                <FluentLabel Weight="FontWeight.Bold">@theme.Name</FluentLabel>
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" HorizontalGap="4" Style="margin-top: 8px;">
                                    <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Title="Edit" aria-label="@($"Edit {theme.Name}")" data-focus-key="@($"edit-{theme.Id}")"
                                                  Disabled="@_rows.IsBusy(theme.Id)" OnClick="@(() => ShowEdit(theme))" IconStart="@(new Size16.Edit())" />
                                    <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Title="Delete" aria-label="@($"Delete {theme.Name}")" data-focus-key="@($"delete-{theme.Id}")"
                                                  Disabled="@_rows.Running" OnClick="@(() => AskDelete(theme))" IconStart="@(new Size16.Delete())" />
                                </FluentStack>
                            </FluentCard>
                        </FluentGridItem>
                    }
                </FluentGrid>
            }
        </FluentCard>
    }
</FluentStack>

@if (_showCreate)
{
    <FluentDialog Modal="true" TrapFocus="@(_confirm is null)" PreventScroll="true" Style="--dialog-width: 400px;" AriaLabel="Add Theme" @ondialogdismiss="@((DialogEventArgs _) => DismissCreate())">
        <FluentDialogBody>
            <FluentLabel aria-level="2" Typo="Typography.H4" Style="margin-bottom: 16px;">Add Theme</FluentLabel>
            <EditForm Model="@_create" OnValidSubmit="Create">
                <DataAnnotationsValidator />
                <FluentTextField @bind-Value="_create.Name" Immediate="true" Label="Name" Required Style="width: 100%;" Placeholder="Enter theme name..." />
                <ApiErrorBar Message="@_dialogError" />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="8" Style="margin-top: 16px;">
                    <FluentButton Appearance="Appearance.Neutral" Disabled="@_saving" OnClick="CancelCreate">Cancel</FluentButton>
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Loading="@_saving" IconStart="@(new Size16.Add())">Add Theme</FluentButton>
                </FluentStack>
            </EditForm>
        </FluentDialogBody>
    </FluentDialog>
}

@if (_editingId != Guid.Empty)
{
    <FluentDialog Modal="true" TrapFocus="@(_confirm is null)" PreventScroll="true" Style="--dialog-width: 400px;" AriaLabel="Edit Theme" @ondialogdismiss="@((DialogEventArgs _) => DismissEdit())">
        <FluentDialogBody>
            <FluentLabel aria-level="2" Typo="Typography.H4" Style="margin-bottom: 16px;">Edit Theme</FluentLabel>
            <EditForm Model="@_edit" OnValidSubmit="SaveEdit">
                <DataAnnotationsValidator />
                <FluentTextField @bind-Value="_edit.Name" Immediate="true" Label="Name" Required Style="width: 100%;" />
                <ApiErrorBar Message="@_dialogError" />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="8" Style="margin-top: 16px;">
                    <FluentButton Appearance="Appearance.Neutral" Disabled="@_saving" OnClick="CancelEdit">Cancel</FluentButton>
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Loading="@_saving" IconStart="@(new Size16.Save())">Save</FluentButton>
                </FluentStack>
            </EditForm>
        </FluentDialogBody>
    </FluentDialog>
}

@if (_confirm is { } confirm)
{
    <ConfirmDialog @key="confirm" Title="@confirm.Title" Message="@confirm.Message" ConfirmText="@confirm.ConfirmText"
                   CancelText="@confirm.CancelText" Destructive="@confirm.Destructive"
                   OnConfirm="@(() => Confirmed(confirm))" OnCancel="@(() => Cancelled(confirm))" />
}

@code {
    private List<ThemeEntity>? _themes;
    private ThemeEntity _create = new() { Name = string.Empty };
    private ThemeEntity _edit = new() { Name = string.Empty };
    private Guid _editingId;
    private bool _showCreate;
    // Set by the save that runs; only that save clears it, never a dismiss.
    private bool _saving;
    // The open Add or Edit dialog: a save only closes the dialog it started from.
    private readonly DialogSession _form = new();
    // The row whose Delete is running.
    private readonly RowAction _rows = new();
    // The open question (delete or discard), if any.
    private ConfirmRequest? _confirm;
    private string _search = string.Empty;
    private ViewMode _viewMode = ViewMode.Table;

    private enum ViewMode { Table, Cards }

    private IQueryable<ThemeEntity> Filtered => string.IsNullOrWhiteSpace(_search)
        ? _themes!.AsQueryable()
        : _themes!.Where(t => t.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)).AsQueryable();

    private void HandleSearch() { }
    // A failed load shows the message and Retry instead of the spinner; the list keeps its previous contents.
    private readonly LoadErrors _loads = new();
    // A failed Delete, shown above the list; the list stays as it was.
    private string? _actionError;
    // A failed create or update, shown inside the open dialog, which keeps the entered data.
    private string? _dialogError;

    protected override async Task OnInitializedAsync() => await Reload();
    private Task Reload() => _loads.LoadAsync("Themes", ThemeSvc.GetAllAsync, v => _themes = v ?? []);

    private void ShowCreate()
    {
        _create = new ThemeEntity { Name = string.Empty };
        _dialogError = null;
        _showCreate = true;
        _form.Open(() => new { _create.Name });
        _ = Focus.RememberAsync("add");
    }

    // The Cancel button closes at once without asking, but never while the save runs.
    private void CancelCreate() { if (!_saving) CloseCreate(); }
    private void CloseCreate() { _showCreate = false; _dialogError = null; _form.Close(); _ = Focus.RestoreAsync(); }
    // Overlay click or Escape.
    private void DismissCreate() => _confirm = ConfirmRequest.ForDismiss(_confirm, _saving, _form.IsDirty, CloseCreate);

    private async Task Create()
    {
        if (_saving) return;
        _saving = true;
        var token = _form.Current;
        var item = _create;
        try
        {
            var error = await ApiResult.SendAsync(() => ThemeSvc.CreateAsync(item));
            var current = _form.IsCurrent(token);
            if (error is not null)
            {
                if (current) _dialogError = error;
                else _actionError = $"The theme was not saved. {error}";
                return;
            }
            if (current) CloseCreate();
            await Reload();
        }
        finally { _saving = false; }
    }

    private void ShowEdit(ThemeEntity t)
    {
        _dialogError = null;
        _editingId = t.Id;
        _edit = new ThemeEntity { Id = t.Id, Name = t.Name };
        _form.Open(() => new { _edit.Name });
        _ = Focus.RememberAsync($"edit-{t.Id}");
    }

    // The Cancel button closes at once without asking, but never while the save runs.
    private void CancelEdit() { if (!_saving) CloseEdit(); }
    private void CloseEdit() { _editingId = Guid.Empty; _dialogError = null; _form.Close(); _ = Focus.RestoreAsync(); }
    // Overlay click or Escape.
    private void DismissEdit() => _confirm = ConfirmRequest.ForDismiss(_confirm, _saving, _form.IsDirty, CloseEdit);

    private async Task SaveEdit()
    {
        if (_saving) return;
        _saving = true;
        var token = _form.Current;
        var item = _edit;
        try
        {
            var error = await ApiResult.SendAsync(() => ThemeSvc.UpdateAsync(item));
            var current = _form.IsCurrent(token);
            if (error is not null)
            {
                if (current) _dialogError = error;
                else _actionError = $"The theme was not saved. {error}";
                return;
            }
            if (current) CloseEdit();
            await Reload();
        }
        finally { _saving = false; }
    }

    private void AskDelete(ThemeEntity t)
    {
        if (_rows.BusyId is not null) return;
        _ = Focus.RememberAsync($"delete-{t.Id}");
        _confirm = ConfirmRequest.Delete("Delete theme", $"Delete {t.Name}? This cannot be undone.", () => _rows.RunAsync(t.Id, () => Delete(t.Id)));
    }

    private async Task Confirmed(ConfirmRequest confirm)
    {
        if (_confirm != confirm) return;
        _confirm = null;
        await confirm.OnConfirm();
        // A Discard closed its form dialog, which returned focus itself. After a delete the row is
        // gone (focus goes to the heading) or, when it failed, its Delete button is enabled again.
        if (!confirm.OverDialog) _ = Focus.RestoreAsync();
    }

    // Keep editing leaves focus in the form dialog; a cancelled delete returns it to the Delete button.
    private void Cancelled(ConfirmRequest confirm)
    {
        if (_confirm != confirm) return;
        _confirm = null;
        if (!confirm.OverDialog) _ = Focus.RestoreAsync();
    }

    private async Task Delete(Guid id)
    {
        var error = await ApiResult.SendAsync(() => ThemeSvc.DeleteAsync(id));
        _actionError = error is null ? null : $"The theme was not deleted. {error}";
        if (error is not null) return;
        await Reload();
    }
}
