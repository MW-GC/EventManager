@page "/games"
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inject LibraryClient<GameEntity> GameClient
@inject ActivityService ActivitySvc
@inject ThemeService ThemeSvc
@inject HolidayService HolidaySvc

@* The shared Library page does the loading, search, dialogs, busy guard and delete confirmation; this page
   adds what is Games-only: the Website field, the icon, Activity counts and the Activities in the Edit dialog. *@
<LibraryPage TItem="GameEntity" Title="Games" Subtitle="Manage your game library" Singular="Game"
             Client="@GameClient" Name="@(g => g.Name)" NewItem="NewGame" CopyItem="CopyGame"
             DirtyFields="@(g => new { g.Name, g.Website })" DeleteMessage="DeleteMessage" Lookups="_lookups"
             NameLabel="Game Name" DialogWidth="DialogWidth"
             GridTemplateColumns="minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) 88px">
    <Columns>
        <TemplateColumn TGridItem="GameEntity" Title="Name" Sortable="true" SortBy="@(GridSort<GameEntity>.ByAscending(g => g.Name))" IsDefaultSortColumn="true">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                @if (!string.IsNullOrWhiteSpace(context.IconUrl))
                {
                    <img src="@context.IconUrl" alt="" style="width: 24px; height: 24px; border-radius: 4px; object-fit: cover;" />
                }
                else
                {
                    <FluentIcon Value="@(new Size20.XboxController())" Color="Color.Neutral" />
                }
                <FluentLabel Weight="FontWeight.Bold">@context.Name</FluentLabel>
            </FluentStack>
        </TemplateColumn>
        <TemplateColumn TGridItem="GameEntity" Title="Website">
            @if (!string.IsNullOrWhiteSpace(context.Website))
            {
                <FluentAnchor Href="@context.Website" Target="_blank" Appearance="Appearance.Hypertext">
                    @TruncateUrl(context.Website)
                </FluentAnchor>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="GameEntity" Title="Activities">
            <FluentBadge Appearance="Appearance.Neutral">@GetActivityCount(context.Id)</FluentBadge>
        </TemplateColumn>
    </Columns>
    <CardTemplate Context="card">
        <FluentGridItem xs="12" sm="6" md="4" lg="3">
            <FluentCard Style="height: 100%;" AreaRestricted="false">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="height: 100%;">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="10">
                        @if (!string.IsNullOrWhiteSpace(card.Item.IconUrl))
                        {
                            <img src="@card.Item.IconUrl" alt="" style="width: 40px; height: 40px; border-radius: 6px; object-fit: cover;" />
                        }
                        else
                        {
                            <div style="width: 40px; height: 40px; border-radius: 6px; background: var(--neutral-layer-4); display: flex; align-items: center; justify-content: center;">
                                <FluentIcon Value="@(new Size24.XboxController())" Color="Color.Neutral" />
                            </div>
                        }
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="flex: 1; min-width: 0;">
                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@card.Name</FluentLabel>
                            <FluentBadge Appearance="Appearance.Neutral" Style="width: fit-content;">
                                @GetActivityCount(card.Item.Id) activities
                            </FluentBadge>
                        </FluentStack>
                    </FluentStack>

                    @if (!string.IsNullOrWhiteSpace(card.Item.Website))
                    {
                        <FluentAnchor Href="@card.Item.Website" Target="_blank" Appearance="Appearance.Hypertext" Style="font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            @TruncateUrl(card.Item.Website)
                        </FluentAnchor>
                    }

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4" Style="margin-top: auto;">
                        <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" data-focus-key="@card.EditKey" Disabled="@card.Busy" OnClick="@card.Edit" IconStart="@(new Size16.Edit())">Edit</FluentButton>
                        <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" data-focus-key="@card.DeleteKey" Disabled="@card.Running" OnClick="@card.Delete" IconStart="@(new Size16.Delete())">Delete</FluentButton>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
    </CardTemplate>
    <EditorFields Context="edit">
        <div>
            <FluentTextField @bind-Value="edit.Item.Website" Immediate="true" Label="Website (Optional)" Style="width: 100%;" Placeholder="https://store.steampowered.com/app/123456" />
            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); font-size: 0.75rem; margin-top: 4px;">
                Paste a Steam store URL or game website to auto-fetch the icon
            </FluentLabel>
        </div>
    </EditorFields>
    <EditorExtra Context="edit">
        @if (edit.IsEdit && ActivitiesOf(edit.Item.Id) is { Count: > 0 } activities)
        {
            <FluentDivider Style="margin: 16px 0;" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                <FluentLabel aria-level="3" Typo="Typography.Subject" Weight="FontWeight.Bold">Activities</FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Activities for this game</FluentLabel>
                <FluentDataGrid Items="@activities.AsQueryable()" TGridItem="ActivityEntity" ItemSize="40">
                    <PropertyColumn Property="@(a => a.Name)" Title="Name" Sortable="true" />
                    <TemplateColumn Title="Tags">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4" Wrap="true">
                            @foreach (var tid in context.ThemeIds)
                            {
                                <TagBadge Kind="TagBadge.TagKind.Theme" Text="@ResolveTheme(tid)" Style="font-size: 0.7rem;" />
                            }
                            @foreach (var hid in context.HolidayIds)
                            {
                                <TagBadge Kind="TagBadge.TagKind.Holiday" Text="@ResolveHoliday(hid)" Style="font-size: 0.7rem;" />
                            }
                        </FluentStack>
                    </TemplateColumn>
                </FluentDataGrid>
            </FluentStack>
        }
    </EditorExtra>
</LibraryPage>

@code {
    private List<ActivityEntity>? _activities;
    private List<ThemeEntity>? _themes;
    private List<HolidayEntity>? _holidays;
    // Activities per Game, counted once whenever the Activities list loads, not on every row render.
    private Dictionary<Guid, int> _activityCounts = [];
    private IReadOnlyList<LibraryLookup> _lookups = [];

    protected override void OnInitialized() => _lookups =
    [
        // The counts follow every save and delete, so the Activities list reloads with the Games.
        new(loads => loads.LoadAsync("Activities", ActivitySvc.GetAllAsync, SetActivities), ReloadAfterWrites: true),
        new(loads => loads.LoadAsync("Themes", ThemeSvc.GetAllAsync, v => _themes = v ?? [])),
        new(loads => loads.LoadAsync("Holidays", HolidaySvc.GetAllAsync, v => _holidays = v ?? []))
    ];

    private static GameEntity NewGame() => new() { Name = string.Empty };

    private static GameEntity CopyGame(GameEntity g) => new()
    {
        Id = g.Id,
        Name = g.Name,
        ImageUrl = g.ImageUrl,
        Website = g.Website,
        IconUrl = g.IconUrl
    };

    private int GetActivityCount(Guid gameId) => _activityCounts.GetValueOrDefault(gameId);

    private void SetActivities(List<ActivityEntity>? activities)
    {
        _activities = activities ?? [];
        _activityCounts = _activities.GroupBy(a => a.GameId).ToDictionary(g => g.Key, g => g.Count());
    }

    private List<ActivityEntity> ActivitiesOf(Guid gameId) => _activities?.Where(a => a.GameId == gameId).ToList() ?? [];

    private string DialogWidth(LibraryEdit<GameEntity> edit) =>
        edit.IsEdit && GetActivityCount(edit.Item.Id) > 0 ? "720px" : "480px";

    // Names the game; a game that activities still use is refused by the server (409), so say so.
    private string DeleteMessage(GameEntity g)
    {
        var count = GetActivityCount(g.Id);
        return count == 0
            ? $"Delete {g.Name}? This cannot be undone."
            : $"{g.Name} has {count} {(count == 1 ? "activity" : "activities")}. The server refuses to delete a game that activities still use, so delete or move them first.";
    }

    private string ResolveTheme(Guid id) => _themes?.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString()[..8];
    private string ResolveHoliday(Guid id) => _holidays?.FirstOrDefault(h => h.Id == id)?.Name ?? id.ToString()[..8];

    private static string TruncateUrl(string url)
    {
        var display = url.Replace("https://", "").Replace("http://", "").TrimEnd('/');
        return display.Length > 40 ? string.Concat(display.AsSpan(0, 37), "...") : display;
    }
}
