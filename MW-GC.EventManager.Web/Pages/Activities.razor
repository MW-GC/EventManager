@page "/activities"
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using MW_GC.EventManager.Web.Shared.Activities
@inject LibraryClient<ActivityEntity> ActivityClient
@inject ActivityService ActivitySvc
@inject LibraryClient<GameEntity> GameClient
@inject LibraryClient<ThemeEntity> ThemeClient
@inject LibraryClient<HolidayEntity> HolidayClient
@inject EventService EventSvc
@inject FocusReturn Focus

@* The shared Library page does the loading, search, Add and Edit dialog, busy guard and delete confirmation; this
   page adds what is Activities-only: the Game (required; chosen on Add, or on Edit when an old Activity has none)
   and the Game filter, the tags, Details and Duplicate, and the details dialog with its Comments panel (#131). *@
<LibraryPage TItem="ActivityEntity" Title="Activities" Subtitle="Manage game activities, rules, and descriptions" Singular="Activity"
             Client="@ActivityClient" Name="ActivityName" NewItem="NewActivity" CopyItem="CopyActivity"
             DirtyFields="FormFields" Lookups="_lookups" Filter="ByGame" Rules="Rules" HasSelect="true"
             NameLabel="Activity Name" DialogWidth="@(_ => "680px")"
             GridTemplateColumns="minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) 152px">
    <SearchExtras>
        <FluentSelect TOption="GameEntity"
                      Items="@_games"
                      OptionValue="@(g => g.Id.ToString())"
                      OptionText="@(g => g.Name)"
                      @bind-SelectedOption="_filterGame"
                      Placeholder="All games"
                      aria-label="Filter by game"
                      Style="width: 180px; min-width: 0; max-width: 100%;" />
    </SearchExtras>
    <Columns>
        <PropertyColumn TGridItem="ActivityEntity" TProp="string" Property="@(a => a.Name)" Title="Name" Sortable="true" />
        <TemplateColumn TGridItem="ActivityEntity" Title="Game"
                        Sortable="true"
                        IsDefaultSortColumn="true"
                        SortBy="@(GridSort<ActivityEntity>.ByAscending(a => GameName(a.GameId)).ThenAscending(a => a.Name))">
            @GameName(context.GameId)
        </TemplateColumn>
        <TemplateColumn TGridItem="ActivityEntity" Title="Tags">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4" Wrap="true">
                @foreach (var tid in context.ThemeIds)
                {
                    <TagBadge Kind="TagBadge.TagKind.Theme" Text="@NameLookup.NameOrIdStart(_themes, tid, t => t.Name)" Style="font-size: 0.7rem;" />
                }
                @foreach (var hid in context.HolidayIds)
                {
                    <TagBadge Kind="TagBadge.TagKind.Holiday" Text="@NameLookup.NameOrIdStart(_holidays, hid, h => h.Name)" Style="font-size: 0.7rem;" />
                }
            </FluentStack>
        </TemplateColumn>
    </Columns>
    @* Details and Duplicate around the shared page's own Edit and Delete: Details, Edit, Duplicate, Delete. *@
    <ActionsBeforeEdit Context="row">
        <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Title="Details" aria-label="@($"Details {row.Name}")" data-focus-key="@DetailsKey(row.Item.Id)"
                      OnClick="@(() => ShowDetails(row.Item))">
            <FluentIcon Value="@(new Size16.Eye())" />
        </FluentButton>
    </ActionsBeforeEdit>
    <ActionsBeforeDelete Context="row">
        <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Title="Duplicate" aria-label="@($"Duplicate {row.Name}")"
                      Disabled="@row.AnyBusy" OnClick="@(() => row.RunAsync(() => Duplicate(row.Item.Id), "The activity was not duplicated."))">
            <FluentIcon Value="@(new Size16.Copy())" />
        </FluentButton>
    </ActionsBeforeDelete>
    <EditorLead Context="edit">
        @* The Game is chosen on Add and stays on Edit, except for an old Activity stored with none: its picker is
           open, so the user can give it the Game it needs. Without one, nothing is sent. *@
        <div style="width: 100%;">
            <FluentSelect TOption="GameEntity"
                          Items="@_games"
                          OptionValue="@(g => g.Id.ToString())"
                          OptionText="@(g => g.Name)"
                          SelectedOption="@(_games?.FirstOrDefault(g => g.Id == edit.Item.GameId))"
                          SelectedOptionChanged="@(g => { if (g is not null) edit.Item.GameId = g.Id; })"
                          Field="@(GameField.On(edit.Item))"
                          @attributes="@edit.FieldAttributes(GameField)"
                          Label="Game"
                          Disabled="@(edit.Stored is { } stored && stored.GameId != Guid.Empty)"
                          Style="width: 100%;" />
            <LibraryFieldMessage Field="GameField" />
        </div>
    </EditorLead>
    <EditorFields Context="edit">
        <FluentTextArea @bind-Value="edit.Item.Description" Immediate="true" Label="Description" Style="width: 100%;" Rows="3" Placeholder="Brief description of the activity..." />

        <FluentTextArea @bind-Value="edit.Item.Rules" Immediate="true" Label="Rules" Style="width: 100%;" Rows="4" Placeholder="Rules for this activity..." />

        <FluentTextArea @bind-Value="edit.Item.SetupRequirements" Immediate="true" Label="Setup Requirements" Style="width: 100%;" Rows="3" Placeholder="What's needed to set up this activity..." />

        @* Side-by-side theme/holiday multi-select *@
        <FluentGrid Spacing="3">
            <FluentGridItem xs="12" sm="6">
                <FluentCard Style="padding: 12px;" AreaRestricted="false">
                    <FluentLabel Weight="FontWeight.Bold" Style="margin-bottom: 4px;">Themes</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); margin-bottom: 8px; font-size: 0.8rem;">Select applicable themes</FluentLabel>
                    @if (_themes is not null)
                    {
                        <div style="max-height: 160px; overflow-y: auto;" role="group" aria-label="Themes">
                            @foreach (var theme in _themes)
                            {
                                <FluentCheckbox Label="@theme.Name"
                                                Value="@edit.Item.ThemeIds.Contains(theme.Id)"
                                                ValueChanged="@(v => ToggleId(edit.Item.ThemeIds, theme.Id, v))" />
                            }
                        </div>
                    }
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem xs="12" sm="6">
                <FluentCard Style="padding: 12px;" AreaRestricted="false">
                    <FluentLabel Weight="FontWeight.Bold" Style="margin-bottom: 4px;">Holidays</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); margin-bottom: 8px; font-size: 0.8rem;">Select applicable holidays</FluentLabel>
                    @if (_holidays is not null)
                    {
                        <div style="max-height: 160px; overflow-y: auto;" role="group" aria-label="Holidays">
                            @foreach (var holiday in _holidays)
                            {
                                <FluentCheckbox Label="@holiday.Name"
                                                Value="@edit.Item.HolidayIds.Contains(holiday.Id)"
                                                ValueChanged="@(v => ToggleId(edit.Item.HolidayIds, holiday.Id, v))" />
                            }
                        </div>
                    }
                </FluentCard>
            </FluentGridItem>
        </FluentGrid>
    </EditorFields>
</LibraryPage>

@* Details dialog — sectioned like the original, with the Activity's Comments *@
@if (_detailActivity is not null)
{
    <FluentDialog Modal="true" TrapFocus="@(_confirm is null)" PreventScroll="true" Style="--dialog-width: 680px;" AriaLabel="@_detailActivity.Name" @ondialogdismiss="@((DialogEventArgs _) => DismissDetails())">
        <FluentDialogBody>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Top" Style="margin-bottom: 4px;">
                <FluentLabel aria-level="2" Typo="Typography.H3">@_detailActivity.Name</FluentLabel>
                <FluentButton Appearance="Appearance.Stealth" Title="Close" aria-label="Close" Disabled="@_commentRequestRunning" OnClick="CancelDetails">
                    <FluentIcon Value="@(new Size20.Dismiss())" />
                </FluentButton>
            </FluentStack>
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="6" Style="margin-bottom: 16px;">
                <FluentIcon Value="@(new Size16.XboxController())" Color="Color.Neutral" />
                <FluentLabel Style="color: var(--neutral-foreground-hint);">@GameName(_detailActivity.GameId)</FluentLabel>
            </FluentStack>

            @if (_detailActivity.ThemeIds.Count > 0 || _detailActivity.HolidayIds.Count > 0)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" Wrap="true" Style="margin-bottom: 16px;">
                    @foreach (var tid in _detailActivity.ThemeIds)
                    {
                        <TagBadge Kind="TagBadge.TagKind.Theme" Text="@NameLookup.NameOrIdStart(_themes, tid, t => t.Name)" />
                    }
                    @foreach (var hid in _detailActivity.HolidayIds)
                    {
                        <TagBadge Kind="TagBadge.TagKind.Holiday" Text="@NameLookup.NameOrIdStart(_holidays, hid, h => h.Name)" />
                    }
                </FluentStack>
            }

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                @if (!string.IsNullOrWhiteSpace(_detailActivity.Description))
                {
                    <div>
                        <FluentLabel aria-level="3" Typo="Typography.Subject" Weight="FontWeight.Bold" Style="margin-bottom: 6px;">Description</FluentLabel>
                        <FluentLabel Style="color: var(--neutral-foreground-rest); line-height: 1.6; white-space: pre-wrap;">@_detailActivity.Description</FluentLabel>
                    </div>
                }

                <FluentDivider />

                @if (!string.IsNullOrWhiteSpace(_detailActivity.Rules))
                {
                    <div>
                        <FluentLabel aria-level="3" Typo="Typography.Subject" Weight="FontWeight.Bold" Style="margin-bottom: 6px;">Rules</FluentLabel>
                        <FluentLabel Style="color: var(--neutral-foreground-rest); line-height: 1.6; white-space: pre-wrap;">@_detailActivity.Rules</FluentLabel>
                    </div>
                }

                <FluentDivider />

                @if (!string.IsNullOrWhiteSpace(_detailActivity.SetupRequirements))
                {
                    <div>
                        <FluentLabel aria-level="3" Typo="Typography.Subject" Weight="FontWeight.Bold" Style="margin-bottom: 6px;">Setup Requirements</FluentLabel>
                        <FluentLabel Style="color: var(--neutral-foreground-rest); line-height: 1.6; white-space: pre-wrap;">@_detailActivity.SetupRequirements</FluentLabel>
                    </div>
                }

                <FluentDivider />

                @* #137: the Activity's performance, its row of the Stats page. Keyed by the Activity, so a load that
                   ends after the dialog closed or moved on never shows in another Activity; wrapped, because sibling
                   keys must differ and the Comments panel uses the same one. It only reads, so it takes no part in
                   the busy guard or the Discard question. It shares the dialog's one Events read with the Comments
                   panel (#186). *@
                <div>
                    <ActivityPerformancePanel @key="_detailActivity.Id" ActivityId="_detailActivity.Id" Events="DetailEvents" />
                </div>

                <FluentDivider />

                @* #131: the Activity's Comments, read and written through their own routes (ADR 0001). Keyed by
                   the Activity, so another Activity gets a new panel. *@
                <CommentsPanel @key="_detailActivity.Id" @ref="_commentsPanel" ActivityId="_detailActivity.Id" Events="DetailEvents"
                               SavingChanged="@((bool running) => _commentRequestRunning = running)"
                               Ask="@((ConfirmRequest question) => _confirm = question)" />
            </FluentStack>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" Style="margin-top: 24px;">
                <FluentButton Appearance="Appearance.Neutral" Disabled="@_commentRequestRunning" OnClick="CancelDetails">Close</FluentButton>
            </FluentStack>
        </FluentDialogBody>
    </FluentDialog>
}

@* The details dialog's own questions (Discard, and the Comments panel's Delete Comment); the shared page asks its
   own (delete, and Discard for Add and Edit). *@
@if (_confirm is { } confirm)
{
    <ConfirmDialog @key="confirm" Title="@confirm.Title" Message="@confirm.Message" ConfirmText="@confirm.ConfirmText"
                   CancelText="@confirm.CancelText" Destructive="@confirm.Destructive"
                   OnConfirm="@(() => Confirmed(confirm))" OnCancel="@(() => Cancelled(confirm))" />
}

@code {
    private List<GameEntity>? _games;
    private List<ThemeEntity>? _themes;
    private List<HolidayEntity>? _holidays;
    private IReadOnlyList<LibraryLookup> _lookups = [];
    private GameEntity? _filterGame;
    // Set while the Comments panel adds, saves or deletes a Comment: the details dialog neither closes nor asks meanwhile.
    private bool _commentRequestRunning;
    // The open details dialog.
    private readonly DialogSession _details = new();
    // The open question of the details dialog (Discard changes?, or the panel's Delete Comment), if any.
    private ConfirmRequest? _confirm;
    private ActivityEntity? _detailActivity;
    // The open dialog's Comments panel (#131), whose unsaved text joins the Discard question.
    private CommentsPanel? _commentsPanel;
    // The open dialog's Events list, read once for its Performance and Comments panels (#186); null until one asks.
    private Task<List<EventEntity>?>? _detailEvents;

    // The Games name each row's Game and fill the Game pickers; the Themes and Holidays name the tags.
    protected override void OnInitialized() => _lookups =
    [
        new(loads => loads.LoadAsync("Games", GameClient.GetAllAsync, v => _games = v ?? [])),
        new(loads => loads.LoadAsync("Themes", ThemeClient.GetAllAsync, v => _themes = v ?? [])),
        new(loads => loads.LoadAsync("Holidays", HolidayClient.GetAllAsync, v => _holidays = v ?? []))
    ];

    private static readonly LibraryName<ActivityEntity> ActivityName = new(a => a.Name, (a, name) => a.Name = name);
    // The Game picker: its rule, its message and its attributes share this one key.
    private static readonly LibraryField GameField = new(nameof(ActivityEntity.GameId));

    // The Details button's focus key, which the details dialog returns focus to when it closes.
    private static string DetailsKey(Guid id) => $"details-{id}";

    private static ActivityEntity NewActivity() => new() { Name = string.Empty };

    private static ActivityEntity CopyActivity(ActivityEntity a) => new()
    {
        Id = a.Id, GameId = a.GameId, Name = a.Name, Description = a.Description,
        Rules = a.Rules, ThemeIds = [.. a.ThemeIds], HolidayIds = [.. a.HolidayIds],
        SetupRequirements = a.SetupRequirements
    };

    // The bound fields of the Add or Edit dialog, compared to tell unsaved changes. Theme and Holiday
    // ids count as sets: unticking a box and ticking it again moves its id to the end of the list.
    private static object FormFields(ActivityEntity a) =>
        new { a.GameId, a.Name, a.Description, a.Rules, a.SetupRequirements, ThemeIds = a.ThemeIds.Order(), HolidayIds = a.HolidayIds.Order() };

    // An Activity needs a Game; the API refuses one without it too.
    private static IEnumerable<LibraryFieldError> Rules(ActivityEntity a) =>
        LibraryRules.GameMessage(a.GameId) is { } message ? [new LibraryFieldError(GameField, message)] : [];

    private bool ByGame(ActivityEntity a) => _filterGame is null || a.GameId == _filterGame.Id;

    private string GameName(Guid gameId) =>
        _games?.FirstOrDefault(g => g.Id == gameId)?.Name ?? PlayStats.NoValue;

    private static void ToggleId(List<Guid> list, Guid id, bool add)
    {
        if (add && !list.Contains(id)) list.Add(id);
        else if (!add) list.Remove(id);
    }

    // Run by the shared page's row-action guard, which shows a failure above the list and reloads after a success.
    private Task<string?> Duplicate(Guid id) => ApiResult.SendAsync(() => ActivitySvc.DuplicateAsync(id));

    // The Events list for the open details dialog: the first panel to ask starts the read and the other gets the
    // same one. A failed read is not kept, so the Performance panel's Retry reads again.
    private Task<List<EventEntity>?> DetailEvents()
    {
        if (_detailEvents is null || _detailEvents.IsFaulted || _detailEvents.IsCanceled) _detailEvents = EventSvc.GetAllAsync();
        return _detailEvents;
    }

    private void ShowDetails(ActivityEntity a)
    {
        _detailActivity = a;
        _detailEvents = null;
        _details.Open();
        _ = Focus.RememberAsync(DetailsKey(a.Id));
    }

    // The Close buttons close at once without asking, but never while a Comment request runs.
    private void CancelDetails() { if (!_commentRequestRunning) CloseDetails(); }

    private void CloseDetails()
    {
        _detailActivity = null;
        _commentsPanel = null;
        _detailEvents = null;
        _details.Close();
        _ = Focus.RestoreAsync();
    }

    // Overlay click or Escape: unsaved Comment text asks first.
    private void DismissDetails() =>
        _confirm = ConfirmRequest.ForDismiss(_confirm, _commentRequestRunning, _commentsPanel?.IsDirty == true, CloseDetails);

    private async Task Confirmed(ConfirmRequest confirm)
    {
        if (_confirm != confirm) return;
        _confirm = null;
        // Discard closes the details dialog, which returns focus itself; a Delete Comment leaves it open, and the
        // question gives focus back to it as it closes.
        await confirm.OnConfirm();
    }

    // Keep editing, or Cancel on a Delete Comment, leaves focus in the open details dialog.
    private void Cancelled(ConfirmRequest confirm)
    {
        if (_confirm != confirm) return;
        _confirm = null;
    }
}
