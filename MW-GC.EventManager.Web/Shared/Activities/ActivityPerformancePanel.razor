@* Activity performance in the Activity details dialog (#137): this Activity's row of the Stats page. It loads the
   four lists the Stats page loads and runs the same PlayStats computation, so its numbers cannot differ from the
   Stats row; nothing is stored (ADR 0001). It only reads, so it never holds the dialog open and has nothing to
   discard. The dialog keys it by the Activity, so a load that ends after the dialog closed or moved to another
   Activity lands in a panel that is no longer shown. An Activity the computation has no row for shows one line
   instead of numbers. *@
@using static MW_GC.EventManager.Web.Services.PerformanceFormat
@inject EventService EventSvc
@inject LibraryClient<GameEntity> GameClient
@inject LibraryClient<ActivityEntity> ActivityClient
@inject EventMetricsClient MetricsClient

<div class="activity-performance">
    <FluentLabel aria-level="3" Typo="Typography.Subject" Weight="FontWeight.Bold" Style="margin-bottom: 6px;">Performance</FluentLabel>
    @if (_row is { } row)
    {
        var performance = row.Performance;
        <dl style="display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0 0 8px 0;">
            <PerformanceTerm Term="Offered in"><span class="performance-offered">@row.Offered</span> @(row.Offered == 1 ? "Event" : "Events")</PerformanceTerm>
            <PerformanceTerm Term="Won" Class="performance-wins">@row.Wins</PerformanceTerm>
            <PerformanceTerm Term="Win rate" Class="performance-win-rate"><PerformanceValue Text="@Percent(performance.WinRate)" /></PerformanceTerm>
            <PerformanceTerm Term="Avg Likes" Class="performance-avg-likes"><PerformanceValue Text="@OneDecimal(performance.AverageLikes)" /></PerformanceTerm>
            <PerformanceTerm Term="Avg attendees" Class="performance-avg-attendees"><PerformanceValue Text="@OneDecimal(performance.AverageAttendees)" /></PerformanceTerm>
        </dl>
        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">@Caveat</FluentLabel>
    }
    else if (_computed)
    {
        @* #182.2: the computation has no row for this Activity (deleted after the page loaded, never offered).
           Say so rather than show a made-up row. *@
        <FluentLabel Typo="Typography.Body" Class="performance-none">No performance to show for this Activity.</FluentLabel>
    }
    else if (_loads.Message is { } message)
    {
        @* Not an alert, as in the Comments panel: nothing the user did here failed. *@
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12" Wrap="true">
            <span role="status">Performance could not be loaded. @message</span>
            <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Loading="@_loading" OnClick="Retry">Retry</FluentButton>
        </FluentStack>
    }
    else
    {
        <FluentProgressRing aria-label="Loading performance..." />
    }
</div>

@code {
    // The Activity whose performance this panel shows.
    [Parameter] public Guid ActivityId { get; set; }
    // The Events list as the dialog reads it once for all its panels (#186); null reads it here.
    [Parameter] public Func<Task<List<EventEntity>?>>? Events { get; set; }

    private readonly LoadErrors _loads = new();
    private List<EventEntity>? _events;
    private List<GameEntity>? _games;
    private List<ActivityEntity>? _activities;
    private List<EventMetricsWithLikes>? _metrics;
    private ActivityPlayStats? _row;
    private bool _computed;
    private bool _loading;

    protected override Task OnInitializedAsync() => Load(_ => true);

    // Retry reads only the lists that failed; the others keep what they loaded.
    private Task Retry() => Load(_loads.Failed);

    // The Stats page's four lists, those that needed(name) asks for. Each list's name is written once (#198.7): it
    // is both what needed is asked and the name LoadErrors records, so Retry can never skip a list by a typo.
    private async Task Load(Func<string, bool> needed)
    {
        if (_loading) return;
        _loading = true;
        Task IfNeeded(string list, Func<string, Task> load) => needed(list) ? load(list) : Task.CompletedTask;
        try
        {
            await Task.WhenAll(
                IfNeeded("Events", list => _loads.LoadAsync(list, Events ?? EventSvc.GetAllAsync, v => _events = v ?? [])),
                IfNeeded("Games", list => _loads.LoadAsync(list, GameClient.GetAllAsync, v => _games = v ?? [])),
                IfNeeded("Activities", list => _loads.LoadAsync(list, ActivityClient.GetAllAsync, v => _activities = v ?? [])),
                IfNeeded("Event metrics", list =>
                    _loads.LoadResultAsync(list, async () => (await MetricsClient.LoadAllAsync()).ItemsOrError(), v => _metrics = v ?? [])));
            // Every Activity in the library or in a past Selection has a row; one that is neither (deleted
            // meanwhile and never offered) has none, and the panel says so.
            if (_events is not null && _games is not null && _activities is not null && _metrics is not null)
            {
                _row = new PlayStats(TimeProvider.System).Compute(_events, _games, _activities, _metrics)
                    .Activities.FirstOrDefault(a => a.Id == ActivityId);
                _computed = true;
            }
        }
        finally { _loading = false; }
    }
}
