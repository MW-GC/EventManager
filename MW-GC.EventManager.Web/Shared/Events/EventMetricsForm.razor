@* The Event metrics form in the Event details dialog (#135): attendees, new attendees, returning
   attendees and amount spent, all optional, for any Event including past ones. Event metrics live in
   their own row with their own ETag (ADR 0001), so this form reads and saves them through their own
   route and never through the Event: saving Selections cannot change them, and saving them never
   conflicts with a Selections edit. The details dialog asks before discarding unsaved values (IsDirty)
   and keeps itself open while a save runs (SavingChanged). The fields come from one list (NewFields). *@
@inject EventMetricsClient MetricsClient

<FluentCard AreaRestricted="false">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="padding: 8px;">
        <FluentLabel aria-level="3" Typo="Typography.Subject" Weight="FontWeight.Bold">Event metrics</FluentLabel>
        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); font-size: 0.75rem;">
            Optional numbers about how the night went. Saved on their own, apart from the Selections.
        </FluentLabel>
        @if (!_loaded)
        {
            @* Not an alert: it is not a result of anything the user did here (like the likes count above). *@
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12" Wrap="true">
                <span role="status">@(_loadError ?? "Loading Event metrics…")</span>
                @if (_loadError is not null)
                {
                    <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Loading="@_loading" OnClick="Load">Retry</FluentButton>
                }
            </FluentStack>
        }
        else
        {
            <FluentGrid Spacing="2">
                @foreach (var field in _fields)
                {
                    <FluentGridItem xs="12" sm="6">
                        <div>
                            @* A screen reader reads the message with the field: it is the field's accessible name while it
                               shows (each message starts with the field's label). An id reference such as aria-describedby
                               cannot reach the input inside the text field's shadow root; aria-label is copied onto it. *@
                            <FluentTextField Id="@field.Id" Label="@field.Label" Value="@field.Text" Immediate="true"
                                             ValueChanged="@((string? v) => SetText(field, v))" Disabled="@_saving" Style="width: 100%;"
                                             Placeholder="@field.Placeholder"
                                             aria-label="@(field.Error ?? field.Label)"
                                             aria-invalid="@(field.Error is null ? null : "true")" />
                            @if (field.Error is { } error)
                            {
                                <div role="alert" style="color: var(--error); font-size: 0.85rem; margin-top: 4px;">@error</div>
                            }
                        </div>
                    </FluentGridItem>
                }
            </FluentGrid>
            @if (_stale)
            {
                <div role="alert" style="color: var(--error);">@StaleMessage</div>
                <div>
                    <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Loading="@_loading" Disabled="@_saving" OnClick="Load">Reload</FluentButton>
                </div>
            }
            @if (_reloadError is not null)
            {
                <div role="alert" style="color: var(--error);">@_reloadError</div>
            }
            @if (_saveError is not null)
            {
                <div role="alert" style="color: var(--error);">@_saveError</div>
            }
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
                @* After a stale save only Reload helps: the tag held is out of date, so Save waits for it. *@
                <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small" Loading="@_saving"
                              Disabled="@(!IsDirty || _loading || _stale)" OnClick="Save">Save metrics</FluentButton>
                @if (_savedNote is not null)
                {
                    <span role="status">@_savedNote</span>
                }
            </FluentStack>
        }
    </FluentStack>
</FluentCard>

@code {
    // The Event whose metrics this form edits. The dialog keys the form by it, so another Event gets a new form.
    [Parameter] public Guid EventId { get; set; }
    // True while a save runs and false when it ends: the dialog neither closes nor asks meanwhile.
    [Parameter] public EventCallback<bool> SavingChanged { get; set; }

    public const string StaleMessage = "These numbers were changed by someone else. Reload and try again.";

    // Every metric the form shows, in order: one entry per metric of EventMetricsEntity. The rules and messages
    // are the API's (EventMetricsRules).
    private static EventMetricsField[] NewFields() =>
    [
        EventMetricsField.Count("Attendees", m => m.Attendees, (m, v) => m.Attendees = v),
        EventMetricsField.Count("New attendees", m => m.NewAttendees, (m, v) => m.NewAttendees = v),
        EventMetricsField.Count("Returning attendees", m => m.ReturningAttendees, (m, v) => m.ReturningAttendees = v),
        EventMetricsField.Amount("Amount spent", m => m.AmountSpent, (m, v) => m.AmountSpent = v),
    ];

    private readonly EventMetricsField[] _fields = NewFields();
    // The row as last read or saved; the fields compare with it to tell an unsaved change.
    private EventMetricsEntity _stored = new();
    // The stored row's ETag, sent back as If-Match; null while no row is stored (a save then creates it).
    private string? _eTag;
    private bool _loaded;
    private bool _loading;
    private bool _saving;
    // A save was refused because someone else saved first: Save waits for Reload.
    private bool _stale;
    // The first read failed (the fields are not shown), or a later Reload failed (the fields stay as typed).
    private string? _loadError;
    private string? _reloadError;
    private string? _saveError;
    private string? _savedNote;

    /// <summary>A value was typed that is not saved yet (typing the stored value back, in any form, is no change).</summary>
    internal bool IsDirty => _loaded && _fields.Any(f => f.Differs(_stored));

    protected override Task OnInitializedAsync() => Load();

    private void SetText(EventMetricsField field, string? value)
    {
        field.Text = value ?? string.Empty;
        field.Error = null;
        _savedNote = null;
    }

    // The first read, Retry after a failed one, and Reload after a stale save: replaces the fields with the row.
    private async Task Load()
    {
        if (_loading || _saving) return;
        _loading = true;
        try
        {
            switch (await MetricsClient.GetAsync(EventId))
            {
                case EventMetricsResult.Stored stored:
                    Show(stored);
                    _loadError = _reloadError = _saveError = _savedNote = null;
                    _stale = false;
                    break;
                case EventMetricsResult.Failed failed when _loaded:
                    _reloadError = $"The Event metrics could not be reloaded. {failed.Error}";
                    break;
                case EventMetricsResult.Failed failed:
                    _loadError = $"Event metrics could not be loaded. {failed.Error}";
                    break;
            }
        }
        finally { _loading = false; }
    }

    private async Task Save()
    {
        // One save at a time: a second click while one runs sends nothing. A stale tag waits for Reload.
        if (_saving || _loading || !_loaded || _stale) return;
        if (Validate() is not { } metrics) return;
        _saving = true;
        _saveError = _savedNote = null;
        await SavingChanged.InvokeAsync(true);
        try
        {
            switch (await MetricsClient.SaveAsync(EventId, metrics, _eTag))
            {
                case EventMetricsResult.Stored stored:
                    Show(stored);
                    _savedNote = "Event metrics saved.";
                    break;
                case EventMetricsResult.Stale:
                    // Someone else saved first. Keep what was typed; Reload reads their numbers.
                    _stale = true;
                    break;
                case EventMetricsResult.Failed failed:
                    _saveError = $"The Event metrics were not saved. {failed.Error}";
                    break;
            }
        }
        finally
        {
            _saving = false;
            await SavingChanged.InvokeAsync(false);
        }
    }

    private void Show(EventMetricsResult.Stored result)
    {
        _stored = result.Metrics;
        foreach (var field in _fields) field.Show(result.Metrics);
        _eTag = result.ETag;
        _loaded = true;
    }

    // Every field's rule, as the API checks it; an empty field is null (cleared). Null when any field fails.
    private EventMetricsEntity? Validate()
    {
        var metrics = new EventMetricsEntity { Id = EventId };
        var ok = true;
        foreach (var field in _fields) ok &= field.Write(metrics);
        return ok ? metrics : null;
    }
}
