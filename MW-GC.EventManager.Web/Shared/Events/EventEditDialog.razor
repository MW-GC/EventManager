@* The create-and-edit Event dialog: the Event's name, date and time, the Filters and slots
   (SlotPanel), and the save. It owns everything it binds, its own "Discard changes?" question and
   the save's busy guard. The page opens it (OpenCreate, OpenEdit) and hears back when an Event was
   saved, so it can reload its list, and when a message belongs on the page instead of here. *@
@inject EventService EventSvc
@inject FocusReturn Focus

@if (_showCustomize)
{
    <FluentDialog Modal="true" TrapFocus="@(_confirm is null)" PreventScroll="true" Style="--dialog-width: 860px; --dialog-height: 85vh;"
                  AriaLabel="@(_editingEvent is not null ? "Edit Event" : "Customize Event")" @ondialogdismiss="@((DialogEventArgs _) => DismissCustomize())">
        <FluentDialogBody>
            <FluentLabel aria-level="2" Typo="Typography.H4" Style="margin-bottom: 4px;">@(_editingEvent is not null ? "Edit Event" : "Customize Event")</FluentLabel>
            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); margin-bottom: 16px;">
                @(_editingEvent is not null ? "Update the event details and game/activity selections" : "Customize the event name and game/activity selections before creating")
            </FluentLabel>

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="overflow-y: auto; max-height: calc(85vh - 200px); padding: 0 12px;">
                @* Event name and date *@
                <FluentGrid Spacing="3">
                    <FluentGridItem xs="12" sm="6">
                        <FluentTextField @bind-Value="_custName" Immediate="true" Label="Event Name" Style="width: 100%;" Placeholder="Enter event name..." />
                    </FluentGridItem>
                    <FluentGridItem xs="12" sm="3">
                        <FluentDatePicker @bind-Value="_custDate" Label="Event Date" Style="width: 100%;" />
                    </FluentGridItem>
                    <FluentGridItem xs="12" sm="3">
                        <FluentTimePicker @bind-Value="_custTime" Immediate="true" Label="Event Time" aria-label="Event Time" Style="width: 100%;" />
                    </FluentGridItem>
                </FluentGrid>

                <SlotPanel Planner="_planner" Games="Games" Activities="Activities" Themes="Themes" Holidays="Holidays"
                           FilterChanged="ApplyFilter" ReplacesWinner="ReplacesWinner" />
            </FluentStack>

            @if (_customizeError is not null)
            {
                <div role="alert" style="color: var(--error); margin-top: 12px;">@_customizeError</div>
            }
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="8" Style="margin-top: 16px;">
                <FluentButton Appearance="Appearance.Neutral" Disabled="@_generating" OnClick="CancelCustomize">Cancel</FluentButton>
                <FluentButton Appearance="Appearance.Accent" Loading="@_generating" OnClick="SaveCustomizedEvent"
                              Disabled="@(string.IsNullOrWhiteSpace(_custName))">
                    @(_editingEvent is not null ? "Update Event" : "Create Event")
                </FluentButton>
            </FluentStack>
        </FluentDialogBody>
    </FluentDialog>
}

@if (_confirm is { } confirm)
{
    <ConfirmDialog @key="confirm" Title="@confirm.Title" Message="@confirm.Message" ConfirmText="@confirm.ConfirmText"
                   CancelText="@confirm.CancelText" Destructive="@confirm.Destructive"
                   OnConfirm="@(() => Confirmed(confirm))" OnCancel="@(() => Cancelled(confirm))" />
}

@code {
    // The library, as the page loaded it.
    [Parameter] public List<GameEntity>? Games { get; set; }
    [Parameter] public List<ActivityEntity>? Activities { get; set; }
    [Parameter] public List<ThemeEntity>? Themes { get; set; }
    [Parameter] public List<HolidayEntity>? Holidays { get; set; }
    // An Event was saved: the page reloads its list (and says so itself if that fails).
    [Parameter] public EventCallback Saved { get; set; }
    // The message the page shows above its list (null clears it).
    [Parameter] public EventCallback<string?> PageError { get; set; }
    // A save that failed after its dialog was closed: the page's dismissable error bar.
    [Parameter] public EventCallback<string> ActionError { get; set; }

    private bool _showCustomize;
    // Set by the save that runs; only that save clears it, never a dismiss.
    private bool _generating;
    // The open customize dialog: a save only closes the dialog it started from.
    private readonly DialogSession _customize = new();
    // The open question (Discard changes?), if any.
    private ConfirmRequest? _confirm;
    private string? _customizeError;
    private EventEntity? _editingEvent;
    // Retain across ambiguous failures and edits in this dialog; only a new create resets it.
    private Guid _createKey = Guid.NewGuid();
    private string _custName = string.Empty;
    private DateTime? _custDate = DateTime.Today;
    private DateTime? _custTime = DateTime.Today.AddHours(19);
    private bool _custThemedOnly;
    private List<Guid> _custGameIds = [];
    private List<Guid> _custThemeIds = [];
    private List<Guid> _custHolidayIds = [];
    private bool _custUniqueGames = true;
    // The slots and every rule that fills them; the dialog keeps only what its inputs bind.
    private readonly SlotPlanner _planner = new(Random.Shared);

    // The planner always rolls from the library the page holds now.
    protected override void OnParametersSet() => _planner.SetLibrary(Games, Activities);

    // The page's Create Event button and a row's Edit button.
    internal void OpenCreate() { ShowCustomize(); StateHasChanged(); }
    internal void OpenEdit(EventEntity e) { ShowEditEvent(e); StateHasChanged(); }

    // A filter input in the SlotPanel changed.
    private void ApplyFilter(SlotFilter filter)
    {
        _custThemedOnly = filter.ThemedOnly;
        _custGameIds = filter.GameIds.ToList();
        _custThemeIds = filter.ThemeIds.ToList();
        _custHolidayIds = filter.HolidayIds.ToList();
        _custUniqueGames = filter.UniqueGames;
        SyncFilter();
    }

    // Hands the filter inputs to the planner; called whenever one of them changes.
    private void SyncFilter() => _planner.Filter =
        new SlotFilter(_custThemedOnly, _custGameIds, _custThemeIds, _custHolidayIds, _custUniqueGames);

    private void ShowCustomize()
    {
        _customizeError = null;
        _editingEvent = null;
        _createKey = Guid.NewGuid();
        _custName = string.Empty;
        _custDate = DateTime.Today;
        _custTime = DateTime.Today.AddHours(19);
        _custThemedOnly = false;
        _custGameIds = [];
        _custThemeIds = [];
        _custHolidayIds = [];
        _custUniqueGames = true;
        SyncFilter();
        _planner.SetSlots([]);
        _planner.AddSlotError = null;
        _planner.RandomizeAll();
        _showCustomize = true;
        _customize.Open(CustomizeFields);
        _ = Focus.RememberAsync("add");
    }

    // The SlotPanel's stand-ins for deleted Games and Activities start empty with every opening.
    private void ShowEditEvent(EventEntity e)
    {
        _customizeError = null;
        _editingEvent = e;
        _planner.GenerationError = null;
        _custName = e.Name;
        var localStart = e.Date.ToLocalTime().DateTime;
        _custDate = localStart.Date;
        _custTime = localStart;
        _custUniqueGames = e.UniqueGamesOnly;
        _custThemedOnly = false;
        _custGameIds = [];
        _custThemeIds = [];
        _custHolidayIds = [];
        SyncFilter();
        _planner.SetSlots(e.Selections.Select(s => new SlotSelection { GameId = s.Game.Id, ActivityId = s.Activity.Id, Stored = s }));
        _planner.AddSlotError = null;
        _showCustomize = true;
        _customize.Open(CustomizeFields);
        _ = Focus.RememberAsync($"edit-{e.Id}");
    }

    // Everything the customize dialog binds, compared to tell unsaved changes. Slots count by their
    // Game and Activity ids only, so an untouched edit of an Event whose Activity was deleted is clean.
    // Date and time count as the parts BuildEventDate saves: the picked day (not the DateTime's Kind,
    // which differs between DateTime.Today and a picked day) and the time of day (a time typed after
    // clearing the box sits on another date).
    private object CustomizeFields() => new
    {
        _custName,
        Date = _custDate is { } date ? DateOnly.FromDateTime(date) : (DateOnly?)null,
        Time = _custTime?.TimeOfDay,
        _custThemedOnly, _custUniqueGames,
        _custGameIds, _custThemeIds, _custHolidayIds,
        Slots = _planner.Slots.Select(s => new { s.GameId, s.ActivityId })
    };

    // The Cancel button closes at once without asking, but never while the save runs.
    private void CancelCustomize() { if (!_generating) CloseCustomize(); }
    private void CloseCustomize() { _showCustomize = false; _customize.Close(); _ = Focus.RestoreAsync(); }
    // Overlay click or Escape. A clean dialog closes once the slot selects are done with the same Escape (#105).
    private Task DismissCustomize()
    {
        var closing = Task.CompletedTask;
        _confirm = ConfirmRequest.ForDismiss(_confirm, _generating, _customize.IsDirty, CloseCustomize,
            closeNow: () => closing = _customize.CloseAfterKeyAsync(CloseCustomize));
        return closing;
    }

    // A Discard closes this dialog, which returns focus to its opener itself.
    private async Task Confirmed(ConfirmRequest confirm)
    {
        if (_confirm != confirm) return;
        _confirm = null;
        await confirm.OnConfirm();
        if (!confirm.OverDialog) _ = Focus.RestoreAsync();
    }

    // Keep editing leaves focus in the open dialog.
    private void Cancelled(ConfirmRequest confirm)
    {
        if (_confirm != confirm) return;
        _confirm = null;
        if (!confirm.OverDialog) _ = Focus.RestoreAsync();
    }

    // What a slot saves: its snapshot while unchanged, otherwise rebuilt from the library.
    // Null when a changed slot names a Game or Activity the library does not offer.
    private Selection? BuildSelection(SlotSelection s)
    {
        if (SlotPanel.Unchanged(s) is { } stored) return stored;
        var game = Games?.FirstOrDefault(g => g.Id == s.GameId);
        var act = Activities?.FirstOrDefault(a => a.Id == s.ActivityId && a.GameId == s.GameId);
        if (game is null || act is null) return null;
        return SelectionSnapshot.From(game, act);
    }

    // The slot held the Event's Winner and its Activity has been changed. One slot always wins.
    private bool ReplacesWinner(SlotSelection s) =>
        _editingEvent?.WinnerActivityId is { } winner && _planner.Slots.Count > 1 &&
        s.Stored?.Activity.Id == winner && s.ActivityId != winner;

    // Combines the selected date and time, then resolves the user's local UTC offset so the
    // stored DateTimeOffset represents the correct instant for downstream consumers such as
    // the planned Discord scheduled-event integration.
    private DateTimeOffset BuildEventDate()
    {
        if (!_custDate.HasValue) return DateTimeOffset.Now;
        var wallClock = _custDate.Value.Date + (_custTime?.TimeOfDay ?? TimeSpan.Zero);
        return new DateTimeOffset(DateTime.SpecifyKind(wallClock, DateTimeKind.Local));
    }

    private async Task SaveCustomizedEvent()
    {
        if (_generating || string.IsNullOrWhiteSpace(_custName)) return;
        _customizeError = null;
        var slots = _planner.Slots;
        if (slots.Count is < 1 or > EventEntity.MaximumSelections)
        {
            _customizeError = "Select 1–5 activities before saving. Adjust the filters or add an activity slot.";
            return;
        }
        // Unchanged slots save their stored snapshot; a changed slot must be a library choice.
        var built = slots.Select(BuildSelection).ToList();
        if (slots.Any(s => s.GameId == Guid.Empty || s.ActivityId == Guid.Empty) || built.Any(s => s is null))
        {
            _customizeError = "Choose a valid game and activity for every slot before saving.";
            return;
        }
        var entity = new EventEntity
        {
            Id = _editingEvent?.Id ?? Guid.Empty,
            Name = _custName,
            Date = BuildEventDate(),
            Selections = built.OfType<Selection>().ToList(),
            UniqueGamesOnly = _custUniqueGames,
            // Replacing the Winner's slot clears the Winner, as its notice says.
            WinnerActivityId = slots.Any(ReplacesWinner) ? null : _editingEvent?.WinnerActivityId
        };
        if (entity.ValidateSelections() is not null)
        {
            _customizeError = "Activities must be distinct, and games must be distinct when Unique games only is enabled.";
            return;
        }
        _generating = true;
        // The dialog this save belongs to; a dismissed or replaced dialog is left alone.
        var token = _customize.Current;
        try
        {
            await PageError.InvokeAsync(null);
            entity.NormalizeWinner();

            using var response = _editingEvent is not null
                ? await EventSvc.UpdateAsync(entity)
                : await EventSvc.SaveAsync(entity, _createKey);
            if (await ApiResult.ErrorAsync(response) is { } error)
            {
                if (_customize.IsCurrent(token)) _customizeError = $"The event was not saved. {error}";
                else await ActionError.InvokeAsync($"The event was not saved. {error}");
                return;
            }

            if (_customize.IsCurrent(token)) CloseCustomize();
            // Saved: the page reloads its list and reports a failed reload itself.
            await Saved.InvokeAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (_customize.IsCurrent(token))
                _customizeError = "The save could not be confirmed. Retry in this dialog to avoid creating a duplicate. If you changed the details, reload the event list and check for the saved event first.";
            else
                await PageError.InvokeAsync("An event save could not be confirmed. Reload the event list and check for the event before creating it again.");
        }
        finally { _generating = false; }
    }
}
