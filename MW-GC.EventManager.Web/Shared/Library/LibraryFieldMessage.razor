@* The editor's messages for one field of the item in the form, shown where this sits (under that field). The
   name rule and a page's own Rules (LibraryRulesValidator) both show their messages through it. The messages sit
   in an element with the field's MessageId, which the field names in aria-describedby (LibraryEdit.FieldAttributes).
   A Fluent text field copies that attribute into its shadow root, where the id cannot be found, so once drawn this
   also links the field's inner input to the messages through the collocated module (#196.2). *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@Field.MessageId">
    @if (_context is not null)
    {
        @foreach (var message in _context.GetValidationMessages(Field.On(_context.Model)))
        {
            <div role="alert" class="validation-message" style="color: var(--error); font-size: 0.85rem; margin-top: 4px;">@message</div>
        }
    }
</div>

@code {
    /// <summary>The module's path, as the app serves its collocated script.</summary>
    public const string Module = "./Shared/Library/LibraryFieldMessage.razor.js";

    [CascadingParameter] private EditContext? CurrentEditContext { get; set; }

    /// <summary>The field whose messages this shows, the same key the field's rule and attributes use.</summary>
    [Parameter, EditorRequired] public LibraryField Field { get; set; } = default!;

    private EditContext? _context;
    private IJSObjectReference? _module;

    protected override void OnParametersSet()
    {
        if (CurrentEditContext is null)
            throw new InvalidOperationException($"{nameof(LibraryFieldMessage)} must sit inside an EditForm.");
        if (ReferenceEquals(CurrentEditContext, _context)) return;
        Detach();
        _context = CurrentEditContext;
        _context.OnValidationStateChanged += StateChanged;
    }

    // The link is a nicety for assistive technology, as focus return is: a missing JS runtime never fails the form.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", Module);
            await _module.InvokeVoidAsync("link", Field.MessageId);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
        }
    }

    private void StateChanged(object? sender, ValidationStateChangedEventArgs e) => StateHasChanged();

    private void Detach()
    {
        if (_context is not null) _context.OnValidationStateChanged -= StateChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Detach();
        if (_module is null) return;
        try { await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
