<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      NETSDK1188: same harmless satellite-resource warning as in the Api and Web test projects (a build with
      invariant globalization cannot resolve the culture folders of Microsoft.TestPlatform). Suppressed here only.
    -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest" Version="4.4.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>
</Project>
