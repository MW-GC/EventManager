<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      NETSDK1188 ("has a resource with the locale 'cs'. This locale is not recognized by .NET") is raised for
      every satellite resource folder (cs, de, ... zh-Hant) of Microsoft.TestPlatform.ObjectModel and
      Microsoft.TestPlatform.TestHost, which Microsoft.NET.Test.Sdk brings in. The SDK checks each folder name
      with CultureInfo.GetCultureInfo, and a build running with invariant globalization
      (DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1, for example on a host without ICU) cannot resolve any culture.
      A newer Microsoft.NET.Test.Sdk (18.10.1) does not change it. The warning is harmless: the SDK still
      copies the resources. Suppressed for this test project only.
    -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest" Version="4.5.1" />
    <PackageReference Include="bunit" Version="2.11.3" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <ProjectReference Include="../MW-GC.EventManager.Web/MW-GC.EventManager.Web.csproj" />
    <!-- DialogRetryTests drives the Events page against the real API handlers in process. -->
    <ProjectReference Include="../MW-GC.EventManager.API/MW-GC.EventManager.API.csproj" />
  </ItemGroup>
</Project>
